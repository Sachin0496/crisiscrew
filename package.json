{
  "name": "crisiscrew",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @crisiscrew/server --filter @crisiscrew/web dev",
    "build": "pnpm --filter @crisiscrew/web build",
    "start": "pnpm build && pnpm --filter @crisiscrew/server start",
    "start:mock": "pnpm build && INTEGRATIONS=mock pnpm --filter @crisiscrew/server start",
    "start:real": "pnpm build && INTEGRATIONS=real pnpm --filter @crisiscrew/server start",
    "mock": "pnpm --filter @crisiscrew/mock start",
    "demo:mock": "pnpm build && node scripts/demo-mock.mjs",
    "test": "vitest run",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck",
    "replay": "pnpm --filter @crisiscrew/server replay",
    "eval": "pnpm --filter @crisiscrew/server eval",
    "embeddings:warm": "pnpm --filter @crisiscrew/server embeddings:warm",
    "calibrate": "pnpm --filter @crisiscrew/server calibrate",
    "laya": "bash scripts/laya.sh",
    "eval:safety": "pnpm --filter @crisiscrew/server eval:safety",
    "eval:impact": "pnpm --filter @crisiscrew/server eval:impact",
    "eval:classifier": "pnpm --filter @crisiscrew/server eval:classifier"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  }
}
