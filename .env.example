# CrisisCrew configuration
#
# Copy this file to .env and fill in only what you have. Every external
# integration is optional: a port whose switch is unset runs in sandbox mode,
# and GET /api/wiring (plus the environment box in the UI) reports which
# ports are live.
#
# Status: Freshdesk (TICKETS=freshdesk), Freshservice (INCIDENTS=freshservice)
# and Vobiz (TELEPHONY=vobiz) are wired: set the switch and its keys and they go live. Everything else is
# designed but not wired yet; selecting it, or a wired adapter without its
# keys, makes the server refuse to start with a clear message.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
# Public HTTPS URL of this server (Cloudflare tunnel or a deploy). Needed for
# the Freshdesk webhook, the Freshdesk sidebar app and remote MCP clients.
PUBLIC_BASE_URL=
# Tokens for admin endpoints (replay, reset, manual tickets) and for the human
# approver. Leave empty for a local demo; set both before exposing the server.
ADMIN_TOKEN=
APPROVER_TOKEN=
# Pacing for sandbox tool calls so an audience can follow the agents (ms).
SANDBOX_LATENCY_MS=350

# ---------------------------------------------------------------------------
# Integrations mode: one switch for Freshdesk, Freshservice (incidents,
# on-call, alerts) and Vobiz together.
#   sandbox  every port reads the scenario (default)
#   mock     the real adapters talk to apps/mock on localhost: `pnpm demo:mock`
#            runs both, and the demo cockpit is at http://localhost:8788.
#            Domains, keys and secrets are the mock's, whatever is set below.
#   real     the real adapters talk to Freshdesk, Freshservice and Vobiz with
#            the keys below. Set a port to sandbox to leave that one out.
# ---------------------------------------------------------------------------
INTEGRATIONS=sandbox     # sandbox | mock | real
# The mock's first port (Freshdesk + cockpit); Freshservice is +1, Vobiz +2
MOCK_PORT=8788

# ---------------------------------------------------------------------------
# Port switches (unset = sandbox)
# ---------------------------------------------------------------------------
TICKETS=sandbox          # sandbox | freshdesk (wired)
INCIDENTS=sandbox        # sandbox | freshservice (wired)
DEPLOYMENTS=sandbox      # sandbox | github
PAYMENTS=sandbox         # sandbox | razorpay-status
METRICS=sandbox          # sandbox (no live option planned)
ORDERS=sandbox           # sandbox (no live option planned)
VOICE=off                # off | elevenlabs (audio for the UI)
TELEPHONY=sandbox        # sandbox | vobiz (wired): outbound phone calls
ONCALL=sandbox           # sandbox | freshservice (wired): who's on call
ALERTS=sandbox           # sandbox | freshservice (wired): operational alerts
INFRA=sandbox            # sandbox | mcp (wired): pods and cloud alarms over MCP
LLM=template             # template | anthropic
CLASSIFIER=embeddings    # embeddings | laya | laya-sim (Laya's questions, answered on this machine without the model)
EMBEDDINGS=local         # local | hash (hash is for unit tests only)
CREDITS=sandbox          # sandbox | dodo (stretch)
TRANSLATE=off            # off | sarvam (stretch)

# ---------------------------------------------------------------------------
# Freshworks: Freshdesk (TICKETS=freshdesk). Wired.
# ---------------------------------------------------------------------------
# yourcompany.freshdesk.com (or just yourcompany)
FRESHDESK_DOMAIN=
# Freshdesk: profile picture -> Profile settings -> View API key
FRESHDESK_API_KEY=
# webhook: an automation rule on ticket creation POSTs {"ticket_id": {{ticket.id}}}
#          to {PUBLIC_BASE_URL}/api/webhooks/freshdesk with this secret in the
#          X-CrisisCrew-Secret header. Needs PUBLIC_BASE_URL. If the rule also
#          sends subject, description ({{ticket.description}}), requester_email,
#          requester_name and source, the ticket is ingested as sent, without
#          reading it back (one API call less per ticket).
# poll:    reads new tickets every FRESHDESK_POLL_SECONDS. No public URL needed.
FRESHDESK_INGEST=webhook # webhook | poll
# Any long random string; required when FRESHDESK_INGEST=webhook
FRESHDESK_WEBHOOK_SECRET=
FRESHDESK_POLL_SECONDS=15
# rest = REST API v2 notes and replies. mcp = Freshdesk's official MCP server at
# https://<domain>/mcp (createTicketNote, replyTicket), with the same API key.
# Each MCP call counts against the plan's MCP action quota.
FRESHDESK_ACTIONS=rest   # rest | mcp
# on: each classified ticket gets its type (Incident, Question, Refund) and tags
# (ticket-failure, area-checkout-payments, classified-by-…) set in Freshdesk.
FRESHDESK_LABELS=off     # off | on
# The demo's "File tickets in Freshdesk" button (real Freshdesk only) files the
# first DEMO_TICKETS tickets of LIVE_WORLD's scenario, one every
# DEMO_TICKET_GAP_MS, from the customers' @example.com addresses. Freshdesk's
# API allows about 50 calls a minute on small plans, so keep the pace gentle.
DEMO_TICKETS=17
DEMO_TICKET_GAP_MS=4000

# ---------------------------------------------------------------------------
# Freshworks: Freshservice (INCIDENTS=freshservice). Wired.
# Every CrisisCrew incident, replays included, files a Freshservice incident.
# ---------------------------------------------------------------------------
# yourcompany.freshservice.com (or just yourcompany)
FRESHSERVICE_DOMAIN=
# Freshservice: profile picture -> Profile settings -> Your API key
FRESHSERVICE_API_KEY=
# Freshservice needs a requester for every ticket: the address incidents are filed as
FRESHSERVICE_REQUESTER_EMAIL=
# Only for accounts with several workspaces
FRESHSERVICE_WORKSPACE_ID=
# Which Freshservice group each service's incidents go to: service=groupId
# pairs, "*" for every other service, e.g. checkout-service=12,*=34
FRESHSERVICE_GROUPS=
# ONCALL=freshservice: who's on call comes from Freshservice On-Call Management
# (same domain and API key). The default schedule id, and optional per-service
# schedules as service=scheduleId pairs, e.g. checkout-service=8569
FRESHSERVICE_ONCALL_SCHEDULE_ID=
FRESHSERVICE_ONCALL_SCHEDULES=
# Lets a Freshservice workflow acknowledge a page: it POSTs {"ticket_id": ...,
# "agent_name": ...} to {PUBLIC_BASE_URL}/api/webhooks/freshservice/acknowledge
# with this secret in the X-CrisisCrew-Secret header. Unset = off.
FRESHSERVICE_WEBHOOK_SECRET=
# ALERTS=freshservice: Freshservice Alert Management (same domain and API key).
# poll: reads alerts updated since the last poll. webhook: a workflow POSTs
# {"alert_id": ...} to {PUBLIC_BASE_URL}/api/webhooks/freshservice/alerts with
# X-CrisisCrew-Secret (FRESHSERVICE_WEBHOOK_SECRET), and CrisisCrew reads it back.
FRESHSERVICE_ALERTS_INGEST=poll   # poll | webhook
FRESHSERVICE_ALERTS_POLL_SECONDS=30
# The demo's "Fire Freshservice alert" button (and scripts/fire-freshservice-alert.mjs)
# plays the monitoring tool: it posts a critical 5xx alert on DEMO_ALERT_SERVICE
# to a webhook integration (Admin > IT Operations Management > Monitoring tools
# > Add > Webhook). Its endpoint URL and authentication key, from the API contract:
FRESHSERVICE_ALERT_WEBHOOK_URL=
FRESHSERVICE_ALERT_WEBHOOK_KEY=
DEMO_ALERT_SERVICE=checkout-service
# Which service each alert is about: a "service:<name>" tag on the alert wins;
# otherwise text=service pairs matched against its resource, node, subject and
# tags, e.g. checkout-5xx=checkout-service,auth-latency=auth-service
FRESHSERVICE_ALERT_SERVICES=

# ---------------------------------------------------------------------------
# GitHub deployments (DEPLOYMENTS=github)
# ---------------------------------------------------------------------------
# Fine-grained token with read access to deployments on the repos below
GITHUB_TOKEN=
# service=owner/repo pairs, comma-separated, e.g. checkout-service=you/checkout-service
GITHUB_DEPLOY_REPOS=
GITHUB_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Payment gateway health (PAYMENTS=razorpay-status). Public, no key needed.
# ---------------------------------------------------------------------------
RAZORPAY_STATUS_URL=https://status.razorpay.com/api/services

# ---------------------------------------------------------------------------
# ElevenLabs (VOICE=elevenlabs)
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
# Pick a voice in the ElevenLabs voice library and paste its id
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Stretch: real outbound call (needs an ElevenLabs agent and a Twilio number
# imported into ElevenLabs; Twilio credentials are entered in the ElevenLabs
# dashboard, not here)
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
DEMO_CALL_TO_NUMBER=

# ---------------------------------------------------------------------------
# Vobiz phone calls (TELEPHONY=vobiz). Wired.
# Pages on-call engineers and calls affected customers. Vobiz fetches what each
# call says from PUBLIC_BASE_URL and signs every callback with the auth token,
# so TELEPHONY=vobiz also needs an https PUBLIC_BASE_URL and an ADMIN_TOKEN.
# Check the line with: POST /api/telephony/test-call {"to": "+91..."} (admin)
# ---------------------------------------------------------------------------
# Vobiz console dashboard: Auth ID and Auth Token
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# The caller id: a number on your Vobiz account, in E.164 format (+91...)
VOBIZ_FROM_NUMBER=
# Hang up an unanswered call after this many seconds of ringing
VOBIZ_RING_TIMEOUT_SEC=30
# Hang up an answered call after this many seconds
VOBIZ_TIME_LIMIT_SEC=300
# The voice of the on-call page. vobiz: Vobiz's own Speak and speech Gather.
# sarvam: the call streams its audio both ways over a WebSocket on
# PUBLIC_BASE_URL, and Sarvam hears (saaras:v3) and speaks (bulbul:v3) each
# turn, in English. What the call says still comes from CrisisCrew's live
# incident state. Needs SARVAM_API_KEY.
VOBIZ_VOICE=vobiz        # vobiz | sarvam
# The only numbers CrisisCrew may call, comma-separated (E.164). Set this for a
# demo: the scenarios' on-call and customer numbers look like real Indian
# mobiles, and any number not listed is refused before dialling.
VOBIZ_ALLOWED_NUMBERS=

# ---------------------------------------------------------------------------
# Infrastructure MCP servers (INFRA=mcp). Wired.
# The Investigator asks Kubernetes servers for a service's pods
# (pods_list_in_namespace) and CloudWatch servers for active alarms
# (get_active_alarms). A server that fails or times out (3 s) is shown as
# "not checked". JSON array; each server has a url OR a command:
# [{"name":"k8s-prod","kind":"kubernetes","url":"https://k8s-mcp.internal.example.com/mcp",
#   "headers":{"Authorization":"Bearer ..."},"namespace":"shop","labelSelector":"app={service}"},
#  {"name":"cloudwatch","kind":"cloudwatch","command":"uvx","args":["awslabs.cloudwatch-mcp-server@latest"],
#   "env":{"AWS_REGION":"ap-south-1"}}]
# ---------------------------------------------------------------------------
INFRA_MCP_SERVERS=
# Hosts a url server may use (https only, except localhost), comma-separated
INFRA_MCP_ALLOWED_HOSTS=

# ---------------------------------------------------------------------------
# Anthropic Claude (LLM=anthropic)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Local embeddings (EMBEDDINGS=local). No key; the model runs on this machine.
# ---------------------------------------------------------------------------
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
# Folder for downloaded model files (defaults to .models/ in the repo)
EMBEDDINGS_MODEL_DIR=
# ONNX threads; 2 keeps a fanless MacBook Air cool
EMBEDDINGS_THREADS=2
# Optional, only for gated models
HF_TOKEN=

# ---------------------------------------------------------------------------
# MCP server (/mcp): one bearer token per identity. Unset tokens are generated
# at startup and printed to the console.
# ---------------------------------------------------------------------------
MCP_TOKEN_PATTERN=
MCP_TOKEN_COMMANDER=
MCP_TOKEN_INVESTIGATOR=
MCP_TOKEN_RECOVERY=
MCP_TOKEN_HANDOFF=
# External clients (Claude Desktop, MCP Inspector, Freshservice Agent Studio's
# MCP Gateway): read-only, including get_customer_impact and get_recovery_coverage
MCP_TOKEN_OPERATOR=

# ---------------------------------------------------------------------------
# Sponsor APIs the organizers may provide.
# ---------------------------------------------------------------------------
# Sarvam AI: the voice of on-call pages (VOBIZ_VOICE=sarvam). TRANSLATE=sarvam
# (translate Hindi/Hinglish tickets before embedding) is designed, not wired.
SARVAM_API_KEY=
# A bulbul:v3 voice: priya, anand, rahul, ritu, …
SARVAM_SPEAKER=priya
# Dodo Payments: issue an approved recovery credit in test mode (CREDITS=dodo)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# AWS: hosting credits
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
