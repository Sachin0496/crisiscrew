# CrisisCrew configuration
#
# Copy this file to .env and fill in only what you have. Every external
# integration is optional: a port whose switch is unset runs in sandbox mode,
# and GET /api/wiring (plus the badge in the UI) reports which ports are live.
#
# Status: the live adapters are NOT wired yet. This file lists every API the
# design uses so keys handed out at the event can be dropped in. Until an
# adapter is wired, selecting it makes the server refuse to start with a
# clear message.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=8787
# Public HTTPS URL of this server (Cloudflare tunnel or a deploy). Needed for
# Freshdesk webhooks and remote MCP clients.
PUBLIC_BASE_URL=
# Tokens for admin endpoints (replay, reset, manual tickets) and for the human
# approver. Leave empty for a local demo; set both before exposing the server.
ADMIN_TOKEN=
APPROVER_TOKEN=
# Pacing for sandbox tool calls so an audience can follow the agents (ms).
SANDBOX_LATENCY_MS=350

# ---------------------------------------------------------------------------
# Port switches (unset = sandbox)
# ---------------------------------------------------------------------------
TICKETS=sandbox          # sandbox | freshdesk
DEPLOYMENTS=sandbox      # sandbox | github
PAYMENTS=sandbox         # sandbox | razorpay-status
METRICS=sandbox          # sandbox (no live option planned)
ORDERS=sandbox           # sandbox (no live option planned)
VOICE=off                # off | elevenlabs
LLM=template             # template | anthropic
EMBEDDINGS=local         # local | hash (hash is for unit tests only)
CREDITS=sandbox          # sandbox | dodo (stretch)
TRANSLATE=off            # off | sarvam (stretch)

# ---------------------------------------------------------------------------
# Freshworks: Freshdesk (TICKETS=freshdesk)
# ---------------------------------------------------------------------------
# yourcompany.freshdesk.com
FRESHDESK_DOMAIN=
# Profile settings -> View API key
FRESHDESK_API_KEY=
# Any random string; the automation rule sends it as the X-CrisisCrew-Secret header
FRESHDESK_WEBHOOK_SECRET=
FRESHDESK_INGEST=webhook # webhook | poll
# mcp = Freshdesk's official MCP server at https://<domain>/mcp (quota: 100/500/1,000
# actions a month on Growth/Pro/Enterprise); rest = REST API v2
FRESHDESK_ACTIONS=rest   # rest | mcp

# ---------------------------------------------------------------------------
# Freshworks: Freshservice / Agent Studio (stretch: register our /mcp endpoint)
# ---------------------------------------------------------------------------
FRESHSERVICE_DOMAIN=
FRESHSERVICE_API_KEY=

# ---------------------------------------------------------------------------
# GitHub deployments (DEPLOYMENTS=github)
# ---------------------------------------------------------------------------
# Fine-grained token with read access to deployments on the repos below
GITHUB_TOKEN=
# service=owner/repo pairs, comma-separated, e.g. checkout-service=you/checkout-service
GITHUB_DEPLOY_REPOS=
GITHUB_ENVIRONMENT=production

# ---------------------------------------------------------------------------
# Payment gateway health (PAYMENTS=razorpay-status). Public, no key needed.
# ---------------------------------------------------------------------------
RAZORPAY_STATUS_URL=https://status.razorpay.com/api/services

# ---------------------------------------------------------------------------
# ElevenLabs (VOICE=elevenlabs)
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
# Pick a voice in the ElevenLabs voice library and paste its id
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# Stretch: real outbound call (needs an ElevenLabs agent and a Twilio number
# imported into ElevenLabs; Twilio credentials are entered in the ElevenLabs
# dashboard, not here)
ELEVENLABS_AGENT_ID=
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
DEMO_CALL_TO_NUMBER=

# ---------------------------------------------------------------------------
# Anthropic Claude (LLM=anthropic)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Local embeddings (EMBEDDINGS=local). No key; the model runs on this machine.
# ---------------------------------------------------------------------------
EMBEDDINGS_MODEL=Xenova/all-MiniLM-L6-v2
# Folder for downloaded model files (defaults to .models/ in the repo)
EMBEDDINGS_MODEL_DIR=
# ONNX threads; 2 keeps a fanless MacBook Air cool
EMBEDDINGS_THREADS=2
# Optional, only for gated models
HF_TOKEN=

# ---------------------------------------------------------------------------
# MCP server (/mcp): one bearer token per identity. Unset tokens are generated
# at startup and printed to the console.
# ---------------------------------------------------------------------------
MCP_TOKEN_PATTERN=
MCP_TOKEN_COMMANDER=
MCP_TOKEN_INVESTIGATOR=
MCP_TOKEN_RECOVERY=
MCP_TOKEN_HANDOFF=
# External clients (Claude Desktop, MCP Inspector, Agent Studio): read-only
MCP_TOKEN_OPERATOR=

# ---------------------------------------------------------------------------
# Sponsor APIs the organizers may provide. Reserved; nothing reads these yet.
# ---------------------------------------------------------------------------
# Sarvam AI: translate Hindi/Hinglish tickets before embedding (TRANSLATE=sarvam)
SARVAM_API_KEY=
# Dodo Payments: issue an approved recovery credit in test mode (CREDITS=dodo)
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Vobiz: Indian telephony for voice calls
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
# AWS: hosting credits
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
