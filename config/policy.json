{
  "$comment": "CrisisCrew policy: who may call which tool, authority limits, detection thresholds, root-cause priors and the recovery policy. The policy gate enforces exactly this file, and GET /api/policy shows it. See docs/design.md sections 5, 7 and 9, and docs/customer-harm-response.md sections 2 to 4.",
  "identities": {
    "pattern": {
      "name": "Pattern Agent",
      "maxLevel": 0,
      "tools": ["search_recent_tickets", "get_incident"]
    },
    "commander": {
      "name": "Incident Commander",
      "maxLevel": 1,
      "tools": ["open_incident", "get_incident", "search_recent_tickets", "update_engineering_incident", "get_recovery_coverage", "page_on_call"]
    },
    "investigator": {
      "name": "Investigator",
      "maxLevel": 0,
      "tools": ["get_payment_health", "get_recent_deployments", "get_service_status", "get_infra_health", "get_incident"]
    },
    "issue_creator": {
      "name": "Issue Creator",
      "maxLevel": 1,
      "tools": ["file_engineering_incident", "update_engineering_incident", "request_rollback_change", "open_problem_record", "get_incident", "get_infra_health"]
    },
    "recovery": {
      "name": "Recovery Agent",
      "maxLevel": 2,
      "tools": [
        "identify_affected_customers",
        "link_ticket_to_incident",
        "add_ticket_note",
        "draft_customer_update",
        "plan_recovery",
        "add_account_note",
        "issue_recovery_credit",
        "get_incident",
        "get_customer_impact"
      ]
    },
    "handoff": {
      "name": "Handoff Agent",
      "maxLevel": 3,
      "tools": ["send_customer_update", "record_contact_preference", "request_human_approval", "issue_recovery_credit", "add_ticket_note", "add_account_note", "get_incident", "get_customer_impact"]
    },
    "operator": {
      "name": "External MCP client",
      "maxLevel": 0,
      "tools": [
        "search_recent_tickets",
        "get_incident",
        "get_customer_impact",
        "get_recovery_coverage",
        "get_payment_health",
        "get_recent_deployments",
        "get_service_status",
        "get_infra_health"
      ]
    }
  },
  "limits": { "authorityLimitInr": 5000, "perCustomerLimitInr": 500 },
  "correlation": {
    "windowMin": 15,
    "edgeThreshold": 0.5,
    "joinThreshold": 0.5,
    "cohesionMin": 0.55,
    "sizeMin": 4,
    "failureShareMin": 0.75,
    "burstPMax": 0.001,
    "baselineFloorPerHour": 3,
    "surfaceMin": 0.35,
    "semanticWeight": 0.5,
    "surfaceTemperature": 0.03,
    "questionPenalty": 0.3
  },
  "rca": {
    "lookbackHours": 6,
    "confidenceFloor": 0.6,
    "priors": { "deploy": 0.5, "provider": 0.25, "infra": 0.15, "unknown": 0.25 },
    "deployGap": { "withinMin": 30, "withinLr": 6, "nearMin": 120, "nearLr": 3, "farLr": 0.5, "afterLr": 0.2 },
    "errorRatio": { "strongMin": 2, "cap": 10, "weakMin": 1.2, "weakLr": 1, "noneLr": 0.3 },
    "provider": { "operationalLr": 0.1, "degradedLr": 8, "uncheckedLr": 1 },
    "infra": { "crashLoopLr": 8, "unreadyLr": 4, "restartsMin": 5, "restartsLr": 2, "healthyLr": 0.3, "alarmLr": 4, "noAlarmLr": 0.6, "saturationPercent": 90, "saturationLr": 3 },
    "methodSpread": { "concentratedShare": 0.8, "concentratedLr": 2, "spreadLr": 0.7 }
  },
  "guardrails": { "allowedLinkHosts": [] },
  "classifier": { "failureMin": 0.6, "surfaceMin": 0.5, "timeoutMs": 1500 },
  "importance": {
    "tier1Surfaces": ["checkout_payments", "login_account"],
    "affectedCustomers": { "p1": 20, "p2": 5 },
    "failedValueInr": { "p1": 200000, "p2": 25000 },
    "priorityCustomers": { "p1": 3, "p2": 1 },
    "deployConfidence": 0.8,
    "pageAt": "P1"
  },
  "issues": {
    "rollbackConfidence": 0.8,
    "problemOnRecovered": true
  },
  "alerts": {
    "openOnCritical": true,
    "joinWindowMin": 60,
    "criticalLr": 4,
    "warningLr": 1.5
  },
  "voice": {
    "maxAttempts": 3,
    "retryAfterMin": 10,
    "callingHours": { "start": 9, "end": 21, "timeZone": "Asia/Kolkata" }
  },
  "oncall": {
    "ackTimeoutMin": 5,
    "maxEscalations": 2
  },
  "recovery": {
    "affectedLookbackMin": 30,
    "creditInr": { "standard": 200, "high": 1000 },
    "highValueInr": 10000
  }
}
